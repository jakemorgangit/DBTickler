<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette carried over from DBTickler v1 so the app stays recognisable. -->

    <SolidColorBrush x:Key="ChromeBackground"        Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceBackground"       Color="#252526" />
    <SolidColorBrush x:Key="ControlBackground"       Color="#333337" />
    <SolidColorBrush x:Key="ControlHoverBackground"  Color="#3E3E42" />

    <SolidColorBrush x:Key="OutlineBrush"            Color="#3E3E42" />
    <SolidColorBrush x:Key="OutlineStrongBrush"      Color="#454545" />

    <SolidColorBrush x:Key="ForegroundBrush"         Color="#E0E0E0" />
    <SolidColorBrush x:Key="MutedForegroundBrush"    Color="#A8A8A8" />

    <SolidColorBrush x:Key="AccentBrush"             Color="#9966CC" />
    <SolidColorBrush x:Key="AccentHoverBrush"        Color="#BF9FDF" />
    <SolidColorBrush x:Key="AccentPressedBrush"      Color="#482968" />
    <SolidColorBrush x:Key="AccentForegroundBrush"   Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush"            Color="#16C60C" />
    <SolidColorBrush x:Key="SuccessHoverBrush"       Color="#13A10E" />
    <SolidColorBrush x:Key="DangerBrush"             Color="#E81123" />
    <SolidColorBrush x:Key="DangerHoverBrush"        Color="#F1707A" />
    <SolidColorBrush x:Key="WarningBrush"            Color="#FFC83D" />

    <SolidColorBrush x:Key="ConsoleBackground"       Color="#161616" />
    <SolidColorBrush x:Key="ConsoleForeground"       Color="#D4D4D4" />

    <SolidColorBrush x:Key="ChartLineBrush"          Color="#BF9FDF" />
    <SolidColorBrush x:Key="ChartFillBrush"          Color="#339966CC" />
    <SolidColorBrush x:Key="ChartGridBrush"          Color="#3E3E42" />
    <SolidColorBrush x:Key="ChartMarkerBrush"        Color="#E81123" />
    <SolidColorBrush x:Key="ChartLatencyBrush"       Color="#4FC1FF" />
    <SolidColorBrush x:Key="ChartLatencyFillBrush"   Color="#334FC1FF" />

</ResourceDictionary>
