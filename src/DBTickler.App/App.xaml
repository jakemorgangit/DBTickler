<Application x:Class="DBTickler.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    The first dictionary is the palette and is swapped wholesale when the
                    theme changes; the control styles that follow reference it with
                    DynamicResource, so they survive the swap.
                -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
