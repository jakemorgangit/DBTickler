<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DBTickler.App</RootNamespace>
    <AssemblyName>DBTickler</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <!--
      Lets the WPF app compile on Linux and in CI containers. It still only runs on Windows;
      this only permits the build to resolve the Windows Desktop reference pack.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Single-file packaging settings live here, but the runtime identifier does not: pinning
      a RID in the project would make an ordinary `dotnet build -c Release` on a Linux CI
      agent try to produce a self-contained Windows build. The RID is passed on the publish
      command instead.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBTickler.Core\DBTickler.Core.csproj" />
  </ItemGroup>

</Project>
