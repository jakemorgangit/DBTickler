<Window x:Class="DBTickler.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBTickler"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBackground}"
        FontFamily="Segoe UI">

    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <TextBox x:Name="ResponseInput" KeyDown="OnKeyDown" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="88" />
            <Button Content="OK" IsDefault="True" Click="OnAccept" MinWidth="88" Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
