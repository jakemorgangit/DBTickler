<Window x:Class="DBTickler.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DBTickler"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBackground}"
        FontFamily="Segoe UI">

    <StackPanel Margin="24">
        <TextBlock Text="DBTickler" FontSize="26" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" />
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" />

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"
                   Text="A workload generator and learning tool for SQL Server. It creates realistic activity so you can watch sessions, waits, locking, blocking and deadlocks as they happen." />

        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Safety" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="DBTickler only ever modifies its own table, dbo.LoadGen. Your tables are read from, never written to. Safe mode blocks writes entirely, and the app warns before running a destructive workload against anything that looks like production." />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Also available as a command-line tool" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="dbtickler run --profile oltp --duration 120 --json results.json" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Text="Copyright © 2025 Jake Morgan — Blackcat Data Solutions Limited" />
        <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="https://blackcat.wales" />

        <Button Content="Close" IsDefault="True" IsCancel="True" Click="OnClose"
                HorizontalAlignment="Right" MinWidth="96" Margin="0,18,0,0"
                Style="{StaticResource AccentButton}" />
    </StackPanel>
</Window>
